# Your own settings and lists — written by the app as you use it.
config.json
recent_urls.json
*.txt
!requirements.txt

# Folders the app creates: your downloads and finished fingerprints, and its
# own scratch space. texts/ is where older versions kept their file lists.
downloads/
pklz-files/
work/
texts/
logs/
console_logs/

# WerZatSong's audfprint is fetched separately (setup.bat or Check setup does it);
# it is not part of this repo. A replaced copy is kept as audfprint.old.
audfprint/
audfprint.old*/
audfprint.download/

# ffmpeg and Node.js, when Check setup installs them for this program only.
tools/

__pycache__/
*.pyc
